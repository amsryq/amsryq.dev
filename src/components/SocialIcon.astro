---
import githubSvg from "simple-icons/icons/github.svg?raw";
import xSvg from "simple-icons/icons/x.svg?raw";
import threadsSvg from "simple-icons/icons/threads.svg?raw";
import instagramSvg from "simple-icons/icons/instagram.svg?raw";

type Icon = { title: string; hex: string; path: string };

function iconFromSvg(svg: string, title: string, hex: string): Icon {
  const path = svg.match(/<path d="([^"]+)"/)?.[1];

  if (!path) {
    throw new Error(`[SocialIcon] Could not read the path for "${title}".`);
  }

  return { title, hex, path };
}

// Import only the four SVG assets used by this site. Importing the package root
// loads its entire multi-megabyte icon catalog during Vite's dependency scan.
const icons: Record<string, Icon> = {
  siGithub: iconFromSvg(githubSvg, "GitHub", "181717"),
  siX: iconFromSvg(xSvg, "X", "000000"),
  siThreads: iconFromSvg(threadsSvg, "Threads", "000000"),
  siInstagram: iconFromSvg(instagramSvg, "Instagram", "E4405F"),
  siLinkedin: {
    title: "LinkedIn",
    hex: "0A66C2",
    path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
  },
};

interface Props {
  name: keyof typeof icons;
  size?: number | string;
  class?: string;
  title?: string;
  useBrandColor?: boolean;
}

const {
  name,
  size = 24,
  class: className = "",
  title,
  useBrandColor = false,
} = Astro.props;

const icon = icons[name];

if (!icon || !icon.path) {
  throw new Error(`[SocialIcon] Icon "${name}" does not exist in the local registry.`);
}
---

<svg
  role="img"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={useBrandColor ? `#${icon.hex}` : "currentColor"}
  class={className}
  aria-hidden={title ? undefined : "true"}
  aria-label={title || undefined}
>
  {title && <title>{title}</title>}
  <path d={icon.path} />
</svg>
