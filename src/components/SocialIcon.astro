---
import * as simpleIcons from "simple-icons";

const customIcons: Record<string, { title: string; hex: string; path: string }> = {
  siLinkedin: {
    title: "LinkedIn",
    hex: "0A66C2",
    path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
  },
};

type SimpleIconKeys = keyof typeof simpleIcons;
type CustomIconKeys = keyof typeof customIcons;

interface Props {
  name: SimpleIconKeys | CustomIconKeys | (string & {});
  size?: number | string;
  class?: string;
  title?: string;
  useBrandColor?: boolean;
}

const {
  name,
  size = 24,
  class: className = "",
  title,
  useBrandColor = false,
} = Astro.props;

const icon = customIcons[name as string] || (simpleIcons as any)[name];

if (!icon || !icon.path) {
  throw new Error(`[SocialIcon] Icon "${name}" does not exist in simple-icons or custom registry.`);
}
---

<svg
  role="img"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={useBrandColor ? `#${icon.hex}` : "currentColor"}
  class={className}
  aria-hidden={title ? undefined : "true"}
  aria-label={title || undefined}
>
  {title && <title>{title}</title>}
  <path d={icon.path} />
</svg>
