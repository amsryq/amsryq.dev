---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-width footer-inner">
    <p class="footer-copyright">&copy; {year} {profile.displayName}</p>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--paper);
    position: relative;
    z-index: 10;
  }

  .footer-inner {
    padding: 24px 0;
    text-align: center;
  }

  .footer-copyright {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.03em;
  }
</style>
