---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getReadingTime } from "../../utils/readingTime";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="blogs — amsryq." description="Blog posts by Amsyar Rasyiq.">
  <div class="simple-blog-page">
    <div class="simple-blog-wrap">
      <header class="simple-blog-top">
        <a href="/" class="simple-brand-logo" aria-label="amsryq home">
          a<span class="simple-brand-dot">.</span>
        </a>
        <h1 class="simple-header-title">blogs</h1>
      </header>

      <main class="simple-post-feed" aria-label="Blog posts">
        {posts.length > 0 ? (
          posts.map((post) => {
            const { id: slug, data, body } = post;
            const formattedDate = data.date.toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
            });
            const readTime = getReadingTime(body);

            return (
              <article class="simple-post-entry">
                <a href={`/blog/${slug}`} class="simple-post-card-link">
                  <h2 class="simple-post-heading">{data.title}</h2>
                  {data.description && <p class="simple-post-snippet">{data.description}</p>}
                  <p class="simple-post-info">
                    <time datetime={data.date.toISOString()}>{formattedDate}</time>
                    <span class="simple-post-sep" aria-hidden="true">|</span>
                    <span class="simple-post-read">{readTime}</span>
                  </p>
                </a>
              </article>
            );
          })
        ) : (
          <div class="simple-blog-empty">
            <p class="simple-blog-empty-title">No posts yet</p>
            <p class="simple-blog-empty-desc">
              Articles and notes are in the works. Check back soon.
            </p>
            <a href="/" class="simple-blog-empty-back">
              <span aria-hidden="true">←</span> back to home
            </a>
          </div>
        )}
      </main>
    </div>
  </div>
</Layout>
