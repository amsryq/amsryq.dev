---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { profile } from "../data/profile";
---

<Layout
  title="amsryq. - aspiring developer | tech enthusiast"
  description={profile.summary}
>
  <div class="morph-system-layer" id="morph-system" aria-label="Navigation">
    <div class="morph-header-backdrop" id="header-backdrop"></div>

    <div class="site-width morph-system-inner" id="morph-system-inner">
      <div class="morph-brand-element" id="morph-brand">
        <a href="/" class="morph-brand-link" draggable="false" aria-label="amsryq home">
          <span class="brand-char-a">a</span><span class="brand-emit-wrap" id="brand-emit-wrap"><span class="emit-letter">m</span><span class="emit-letter">s</span><span class="emit-letter">r</span><span class="emit-letter">y</span><span class="emit-letter">q</span></span><span class="brand-char-dot">.</span>
        </a>
      </div>

      <p class="morph-tagline-element" id="morph-tagline">
        aspiring developer | tech enthusiast
      </p>

      <div class="morph-socials-element" id="morph-socials">
        <a href={profile.socials.github} target="_blank" rel="noopener" aria-label="GitHub" class="social-icon">
          <SocialIcon name="siGithub" size={22} />
        </a>
        <a href={profile.socials.x} target="_blank" rel="noopener" aria-label="X (Twitter)" class="social-icon">
          <SocialIcon name="siX" size={20} />
        </a>
        <a href={profile.socials.threads} target="_blank" rel="noopener" aria-label="Threads" class="social-icon">
          <SocialIcon name="siThreads" size={20} />
        </a>
        <a href={profile.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="social-icon">
          <SocialIcon name="siInstagram" size={20} />
        </a>
        <a href="#socials" class="social-more" aria-label="See all socials">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </div>

      <nav class="morph-nav-element" id="morph-nav" aria-label="Page navigation">
        <div class="morph-anchors-group" id="morph-anchors">
          <a href="#" class="morph-link is-active" data-section="about">about</a>
          <a href="#projects" class="morph-link" data-section="projects">projects</a>
          <a href="#socials" class="morph-link" data-section="socials">socials</a>
          <a href="#contact" class="morph-link" data-section="contact">contact</a>
        </div>

        <span class="morph-pipe-char" id="morph-pipe" aria-hidden="true">|</span>

        <div class="morph-blogs-group" id="morph-blogs">
          <a href="/blog" class="morph-link morph-blog-link">blogs</a>
        </div>
      </nav>
    </div>
  </div>

  <main>
    <section class="landing-hero-trigger" id="hero-trigger" aria-hidden="true">
      <div class="hero-scroll-buffer"></div>
    </section>

    <section class="section section-about" id="about">
      <div class="site-width section-content">
        <div class="about-content">
          <p class="about-lead">
            {profile.summary}  
          </p>
          <div class="about-tools-section">
            <span class="tools-label">Languages & Tools</span>
            <div class="about-tools">
              <a href="https://www.typescriptlang.org/" class="tool-pill" title="TypeScript">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" width="24" alt="TypeScript">
                <span>TypeScript</span>
              </a>
              <a href="https://kotlinlang.org/" class="tool-pill" title="Kotlin">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kotlin/kotlin-original.svg" width="24" alt="Kotlin">
                <span>Kotlin</span>
              </a>
              <a href="https://learn.microsoft.com/en-us/dotnet/csharp/" class="tool-pill" title="C#">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg" width="24" alt="C#">
                <span>C#</span>
              </a>
              <a href="https://code.visualstudio.com/" class="tool-pill" title="VS Code">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg" width="24" alt="VS Code">
                <span>VS Code</span>
              </a>
              <a href="https://developer.android.com/studio" class="tool-pill" title="Android Studio">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/androidstudio/androidstudio-original.svg" width="24" alt="Android Studio">
                <span>Android Studio</span>
              </a>
              <a href="https://www.jetbrains.com/" class="tool-pill" title="JetBrains">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jetbrains/jetbrains-original.svg" width="24" alt="JetBrains">
                <span>JetBrains</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="projects" aria-labelledby="projects-heading">
      <div class="site-width section-content">
        <h2 id="projects-heading" class="section-title">Projects</h2>
        <div class="projects-list">
          {profile.projects.map((project, index) => (
            <article class="project-card" id={project.slug}>
              <div class="project-card-top">
                <span class="project-card-index">0{index + 1}</span>
                <span class="project-card-type">{project.type}</span>
              </div>
              <h3 class="project-card-name">{project.name}</h3>
              <p class="project-card-summary">{project.summary}</p>
              <div class="project-card-bottom">
                <span class="project-card-stack">{project.stack}</span>
                <span class="project-card-metric">{project.metric}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="socials" aria-labelledby="socials-heading">
      <div class="site-width section-content">
        <h2 id="socials-heading" class="section-title">Socials</h2>
        <div class="socials-grid">
          <a href={profile.socials.github} target="_blank" rel="noopener" class="social-card">
            <div class="social-card-left">
              <SocialIcon name="siGithub" size={20} />
              <span class="social-card-label">GitHub</span>
            </div>
            <div class="social-card-right">
              <span class="social-card-handle">@amsryq</span>
              <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
            </div>
          </a>
          <a href={profile.socials.x} target="_blank" rel="noopener" class="social-card">
            <div class="social-card-left">
              <SocialIcon name="siX" size={18} />
              <span class="social-card-label">X</span>
            </div>
            <div class="social-card-right">
              <span class="social-card-handle">@amsryq</span>
              <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
            </div>
          </a>
          <a href={profile.socials.threads} target="_blank" rel="noopener" class="social-card">
            <div class="social-card-left">
              <SocialIcon name="siThreads" size={18} />
              <span class="social-card-label">Threads</span>
            </div>
            <div class="social-card-right">
              <span class="social-card-handle">@amsryq</span>
              <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
            </div>
          </a>
          <a href={profile.socials.instagram} target="_blank" rel="noopener" class="social-card">
            <div class="social-card-left">
              <SocialIcon name="siInstagram" size={18} />
              <span class="social-card-label">Instagram</span>
            </div>
            <div class="social-card-right">
              <span class="social-card-handle">@amsryq</span>
              <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
            </div>
          </a>
          <a href={profile.socials.linkedin} target="_blank" rel="noopener" class="social-card">
            <div class="social-card-left">
              <SocialIcon name="siLinkedin" size={18} />
              <span class="social-card-label">LinkedIn</span>
            </div>
            <div class="social-card-right">
              <span class="social-card-handle">amsryq</span>
              <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
            </div>
          </a>
          <a href={`mailto:${profile.email}`} class="social-card">
            <div class="social-card-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="social-card-label">Email</span>
            </div>
            <div class="social-card-right">
              <span class="social-card-handle">{profile.email}</span>
              <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section section-dark" id="contact" aria-labelledby="contact-heading">
      <div class="site-width section-content">
        <div class="contact-layout">
          <h2 id="contact-heading" class="section-title section-title-light">Get in touch</h2>
          <p class="contact-text">
            Have something worth making simpler? I'm always open to interesting conversations, collaboration, or project ideas.
          </p>
          <a class="contact-cta" href={`mailto:${profile.email}`}>
            Email me <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let activeObserver: IntersectionObserver | null = null;
  let currentTimeline: gsap.core.Timeline | null = null;

  function initMorphNav() {
    const brandEl = document.getElementById("morph-brand");
    const emitWrap = document.getElementById("brand-emit-wrap");
    const emitLetters = document.querySelectorAll(".emit-letter");
    const taglineEl = document.getElementById("morph-tagline");
    const socialsEl = document.getElementById("morph-socials");
    const navEl = document.getElementById("morph-nav");
    const anchorsEl = document.getElementById("morph-anchors");
    const pipeEl = document.getElementById("morph-pipe");
    const blogsEl = document.getElementById("morph-blogs");
    const backdropEl = document.getElementById("header-backdrop");
    const heroTrigger = document.getElementById("hero-trigger");

    if (!brandEl || !navEl || !heroTrigger || !emitWrap) return;

    const brandLink = brandEl.querySelector(".morph-brand-link");
    brandLink?.addEventListener("click", (e) => {
      e.preventDefault();
      if (brandEl.classList.contains("is-collapsed")) {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });

    brandLink?.addEventListener("dragstart", (e) => {
      if (!brandEl.classList.contains("is-collapsed")) {
        e.preventDefault();
      }
    });

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      ScrollTrigger.create({
        trigger: heroTrigger,
        start: "bottom top+=56",
        onEnter: () => {
          backdropEl?.classList.add("is-visible");
          brandEl.classList.add("is-collapsed");
        },
        onLeaveBack: () => {
          backdropEl?.classList.remove("is-visible");
          brandEl.classList.remove("is-collapsed");
        },
      });
      return;
    }

    function buildTimeline() {
      if (!brandEl || !navEl || !heroTrigger || !emitWrap) return;

      if (currentTimeline) {
        currentTimeline.kill();
        currentTimeline = null;
      }

      gsap.set([brandEl, taglineEl, socialsEl, navEl, anchorsEl, pipeEl, blogsEl, emitWrap, backdropEl], { clearProps: "all" });
      gsap.set(emitLetters, { clearProps: "all" });

      const isMobile = window.innerWidth <= 768;
      const heroTriggerH = heroTrigger ? heroTrigger.offsetHeight : 520;
      const logoH = brandEl.offsetHeight || (isMobile ? 54 : 96);
      const taglineH = taglineEl ? taglineEl.offsetHeight : 24;
      const socialsH = socialsEl ? socialsEl.offsetHeight : 32;
      const totalBlockH = logoH + taglineH + socialsH + (isMobile ? 48 : 66) + 32;

      const heroLogoTop = isMobile
        ? Math.max(36, Math.round((heroTriggerH - totalBlockH) * 0.40))
        : Math.max(64, Math.round((heroTriggerH - totalBlockH) * 0.46));

      const heroTaglineTop = heroLogoTop + logoH + (isMobile ? 12 : 14);
      const heroSocialsTop = heroTaglineTop + taglineH + (isMobile ? 16 : 20);
      const heroNavTop = heroSocialsTop + socialsH + (isMobile ? 22 : 32);

      gsap.set(brandEl, { top: heroLogoTop, left: 0 });
      if (taglineEl) gsap.set(taglineEl, { top: heroTaglineTop, left: 0 });
      if (socialsEl) gsap.set(socialsEl, { top: heroSocialsTop, left: 0 });
      gsap.set(navEl, { top: heroNavTop, left: 0, width: "100%" });

      const headerTopBrand = 14;
      const headerTopNav = 18;
      const targetFontSize = isMobile ? 26 : 28;
      const morphBrandLink = brandEl.querySelector<HTMLElement>(".morph-brand-link") || brandEl;
      const heroFontSize = parseFloat(window.getComputedStyle(morphBrandLink).fontSize) || (isMobile ? 44 : 120);
      const logoScale = targetFontSize / (heroFontSize || 1);

      const logoDeltaY = headerTopBrand - heroLogoTop;

      const charA = brandEl.querySelector<HTMLElement>(".brand-char-a");
      const charDot = brandEl.querySelector<HTMLElement>(".brand-char-dot");
      const charAWidth = charA ? charA.offsetWidth : 24;
      const charDotWidth = charDot ? charDot.offsetWidth : 12;
      const logoHeaderWidth = (charAWidth + charDotWidth) * logoScale;

      const gap = isMobile ? 10 : 28;
      const targetAnchorsLeft = Math.round(logoHeaderWidth + gap);

      const originAnchorsLeft = anchorsEl ? anchorsEl.offsetLeft : 0;
      const originNavTop = heroNavTop;

      const anchorsDeltaX = targetAnchorsLeft - originAnchorsLeft;
      const anchorsDeltaY = headerTopNav - originNavTop;

      const siteContainer = document.getElementById("morph-system-inner");
      const siteWidth = siteContainer ? siteContainer.offsetWidth : window.innerWidth;
      const blogsWidth = blogsEl ? blogsEl.offsetWidth : 48;
      const targetBlogsLeft = siteWidth - blogsWidth;

      const originBlogsLeft = blogsEl ? blogsEl.offsetLeft : (originAnchorsLeft + (anchorsEl ? anchorsEl.offsetWidth : 200) + 40);
      const blogsDeltaX = targetBlogsLeft - originBlogsLeft;
      const blogsDeltaY = headerTopNav - originNavTop;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: heroTrigger,
          start: "top top",
          end: "bottom top+=56",
          scrub: 0.3,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (self.progress > 0.5) {
              brandEl.classList.add("is-collapsed");
            } else {
              brandEl.classList.remove("is-collapsed");
            }
          },
        },
      });

      if (taglineEl) {
        tl.to(taglineEl, { opacity: 0, y: -12, ease: "power1.in", duration: 0.3 }, 0);
      }
      if (socialsEl) {
        tl.to(socialsEl, { opacity: 0, y: -12, ease: "power1.in", duration: 0.3 }, 0);
      }

      tl.to(
        emitLetters,
        {
          y: (i) => -12 - i * 3,
          x: (i) => 6 + i * 4,
          opacity: 0,
          stagger: 0.02,
          ease: "power2.inOut",
          duration: 0.4,
        },
        0.05
      );

      tl.to(
        emitWrap,
        {
          width: 0,
          opacity: 0,
          ease: "power2.inOut",
          duration: 0.45,
        },
        0.08
      );

      tl.to(
        brandEl,
        {
          y: logoDeltaY,
          scale: logoScale,
          transformOrigin: "top left",
          ease: "power2.inOut",
          duration: 0.8,
        },
        0.05
      );

      if (anchorsEl) {
        tl.to(
          anchorsEl,
          {
            x: anchorsDeltaX,
            y: anchorsDeltaY,
            ease: "power2.inOut",
            duration: 0.8,
          },
          0.05
        );
      }

      if (pipeEl) {
        tl.to(pipeEl, { opacity: 0, scale: 0.3, ease: "power1.in", duration: 0.3 }, 0.1);
      }

      if (blogsEl) {
        tl.to(
          blogsEl,
          {
            x: blogsDeltaX,
            y: blogsDeltaY,
            ease: "power2.inOut",
            duration: 0.8,
          },
          0.05
        );
      }

      if (backdropEl) {
        tl.to(backdropEl, { opacity: 1, ease: "power1.inOut", duration: 0.4 }, 0.3);
      }

      currentTimeline = tl;
    }

    buildTimeline();

    let resizeTimer: number;
    function handleResize() {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        buildTimeline();
        ScrollTrigger.refresh();
      }, 100);
    }

    window.addEventListener("resize", handleResize);
    window.addEventListener("orientationchange", handleResize);

    if (activeObserver) activeObserver.disconnect();

    const links = document.querySelectorAll(".morph-anchors-group .morph-link");
    const sectionIdToNav: Record<string, string> = { "hero-trigger": "about" };
    activeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = sectionIdToNav[entry.target.id] || entry.target.id;
            links.forEach((link) => {
              link.classList.toggle("is-active", link.getAttribute("data-section") === id);
            });
          }
        });
      },
      { rootMargin: "-30% 0px -50% 0px" }
    );

    document.querySelectorAll("section[id]").forEach((section) => activeObserver?.observe(section));
  }

  function safeInit() {
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        initMorphNav();
      });
    } else {
      initMorphNav();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", safeInit);
  } else {
    safeInit();
  }
  document.addEventListener("astro:page-load", safeInit);
</script>
