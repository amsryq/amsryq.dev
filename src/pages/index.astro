---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SocialIcon from "../components/SocialIcon.astro";
import Projects from "../components/Projects.astro";
import { profile } from "../data/profile";
---

<Layout
  title="amsryq. - aspiring developer | tech enthusiast"
  description={profile.summary}
>
  <Header slot="header" />

  <section class="landing-hero-trigger" id="hero-trigger" aria-hidden="true">
    <div class="hero-scroll-buffer"></div>
  </section>

  <section class="section section-about" id="about">
    <div class="site-width section-content">
      <div class="about-content">
        <p class="about-lead">
          {profile.summary}  
        </p>
        <div class="about-tools-section">
          <span class="tools-label">Languages & Tools</span>
          <div class="about-tools">
            <a href="https://www.typescriptlang.org/" class="tool-pill" title="TypeScript">
              <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" width="24" alt="TypeScript">
              <span>TypeScript</span>
            </a>
            <a href="https://kotlinlang.org/" class="tool-pill" title="Kotlin">
              <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kotlin/kotlin-original.svg" width="24" alt="Kotlin">
              <span>Kotlin</span>
            </a>
            <a href="https://learn.microsoft.com/en-us/dotnet/csharp/" class="tool-pill" title="C#">
              <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg" width="24" alt="C#">
              <span>C#</span>
            </a>
            <a href="https://code.visualstudio.com/" class="tool-pill" title="VS Code">
              <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg" width="24" alt="VS Code">
              <span>VS Code</span>
            </a>
            <a href="https://developer.android.com/studio" class="tool-pill" title="Android Studio">
              <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/androidstudio/androidstudio-original.svg" width="24" alt="Android Studio">
              <span>Android Studio</span>
            </a>
            <a href="https://www.jetbrains.com/" class="tool-pill" title="JetBrains">
              <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jetbrains/jetbrains-original.svg" width="24" alt="JetBrains">
              <span>JetBrains</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {false && <Projects />}

  <section class="section" id="socials" aria-labelledby="socials-heading">
    <div class="site-width section-content">
      <h2 id="socials-heading" class="section-title">Socials</h2>
      <div class="socials-grid">
        <a href={profile.socials.github} target="_blank" rel="noopener" class="social-card">
          <div class="social-card-left">
            <SocialIcon name="siGithub" size={20} />
            <span class="social-card-label">GitHub</span>
          </div>
          <div class="social-card-right">
            <span class="social-card-handle">@amsryq</span>
            <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
          </div>
        </a>
        <a href={profile.socials.x} target="_blank" rel="noopener" class="social-card">
          <div class="social-card-left">
            <SocialIcon name="siX" size={18} />
            <span class="social-card-label">X</span>
          </div>
          <div class="social-card-right">
            <span class="social-card-handle">@amsryq</span>
            <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
          </div>
        </a>
        <a href={profile.socials.threads} target="_blank" rel="noopener" class="social-card">
          <div class="social-card-left">
            <SocialIcon name="siThreads" size={18} />
            <span class="social-card-label">Threads</span>
          </div>
          <div class="social-card-right">
            <span class="social-card-handle">@amsryq</span>
            <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
          </div>
        </a>
        <a href={profile.socials.instagram} target="_blank" rel="noopener" class="social-card">
          <div class="social-card-left">
            <SocialIcon name="siInstagram" size={18} />
            <span class="social-card-label">Instagram</span>
          </div>
          <div class="social-card-right">
            <span class="social-card-handle">@amsryq</span>
            <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
          </div>
        </a>
        <a href={profile.socials.linkedin} target="_blank" rel="noopener" class="social-card">
          <div class="social-card-left">
            <SocialIcon name="siLinkedin" size={18} />
            <span class="social-card-label">LinkedIn</span>
          </div>
          <div class="social-card-right">
            <span class="social-card-handle">amsryq</span>
            <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
          </div>
        </a>
        <a href={`mailto:${profile.email}`} class="social-card">
          <div class="social-card-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span class="social-card-label">Email</span>
          </div>
          <div class="social-card-right">
            <span class="social-card-handle">{profile.email}</span>
            <span class="social-card-arrow" aria-hidden="true">&#8599;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-dark" id="contact" aria-labelledby="contact-heading">
    <div class="site-width section-content">
      <div class="contact-layout">
        <h2 id="contact-heading" class="section-title section-title-light">Get in touch</h2>
        <p class="contact-text">
          Have something worth making simpler? I'm always open to interesting conversations, collaboration, or project ideas.
        </p>
        <a class="contact-cta" href={`mailto:${profile.email}`}>
          Email me <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
