			<div style="display:none">
				<a class="link" href="/about">about</a>
				&nbsp;|&nbsp;
				<a class="link" href="/blog">blogs</a>
			</div>
		</main>
	</body>
</html>

<style>
	body {
		margin: 0;
		height: 100vh;
		display: flex;
		flex-direction: column;
	}
	main {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
	}
	.link {
		margin-top: 20px;
		font-size: 1.4rem;
		text-decoration: none;
		color: #848484;
	}
	.social-links {
		display: flex;
		gap: 1.5rem;
		margin-top: 2rem;
		align-items: center;
		justify-content: center;
	}
	.social-links a {
		color: #666;
		transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
	}
	.social-links a:hover {
		color: #222;
		transform: translateY(-4px) scale(1.1);
	}
	.social-links svg {
		width: 28px;
		height: 28px;
	}
</style>